/* ===== 2048 肉鸽版 屏幕（复用原作 + 双人兼容）=====
 * 原作在 iframe 里原封跑；父页面用 contentWindow.eval / 事件派发完成全部双人兼容：
 *   ① 转发方向输入：既发 keydown，也发 #board 上的指针/触摸滑动（原作两条路都支持）
 *      注意事件要往**多个目标**发 —— 事件只向上冒泡，发在 document 上不会往下传给棋盘元素
 *   ② 捕获阶段拦掉 iframe 内的本地按键（输入只能由我们喂，否则两端会分叉）
 *   ③ 轮询读进度：它是 canvas 渲染（#tiles 是空容器），所以从可见文本里取 SCORE n / MOVES n
 * 不注入桥接脚本，所以 iframe 重载也不会打断同步。 */
(function (root) {
  'use strict';
  var PN = root.PN = root.PN || {};
  var esc = PN.esc;
  var KEYS = { up: 'ArrowUp', down: 'ArrowDown', left: 'ArrowLeft', right: 'ArrowRight' };
  var CODES = { up: 38, down: 40, left: 37, right: 39 };
  var VEC = { left: [-1, 0], right: [1, 0], up: [0, -1], down: [0, 1] };

  var S = { frame: null, applied: 0, ui: null, poller: null, win: null,
    score: 0, moves: 0, started: false, clickTries: 0, overSent: false, lastSig: '', err: null, dom: false };

  function frameWin() { try { return S.frame && S.frame.contentWindow; } catch (e) { return null; } }
  function $(w, sel) { try { return w.document.querySelector(sel); } catch (e) { return null; } }

  /** 固定种子覆盖 iframe 内的 Math.random：2048 出新方块是随机的，两端同种子才可能一致 */
  function installSeed(w) {
    var ui = S.ui, g = ui && ui.state && ui.state.g;
    if (!w || !g || w.__pnSeeded === g.seed) return;
    try {
      var s = g.seed >>> 0;
      w.Math.random = function () {
        s = (s + 0x6D2B79F5) >>> 0;
        var t = s;
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
      w.__pnSeeded = g.seed;
    } catch (e) { S.err = String(e && e.message); }
  }

  function setup(w) {
    if (!w || !w.document || !w.document.body) return;
    installSeed(w);
    if (S.started) return;
    if ((S.clickTries || 0) > 12) return;
    S.clickTries++;
    var btn = $(w, '#startBtn');
    if (!btn) {
      var bs = [];
      try { bs = Array.prototype.slice.call(w.document.querySelectorAll('button, [role=button]')); } catch (e) { bs = []; }
      for (var i = 0; i < bs.length; i++) {
        if (/开始|Start|Play/i.test(String(bs[i].textContent || ''))) { btn = bs[i]; break; }
      }
    }
    if (!btn) return;
    try { btn.click(); } catch (e) {}
    try {
      w.document.addEventListener('keydown', function (e) {
        if (w.__pnAllow) return;
        e.preventDefault(); e.stopPropagation();
      }, true);
      S.started = true;
    } catch (e) { S.err = String(e && e.message); }
  }

  /** 把权威日志里还没落地的方向，逐条喂进 iframe（键 + 指针/触摸滑动，多目标） */
  function applyLog() {
    var ui = S.ui, g = ui && ui.state && ui.state.g;
    if (!ui || !g) return;
    var w = frameWin();
    if (!w || !S.started) return;
    if (g.log.length < S.applied) { S.applied = 0; return; }
    for (var i = S.applied; i < g.log.length; i++) {
      var dir = g.log[i], key = KEYS[dir];
      if (!key) continue;
      try { w.__pnAllow = true; } catch (e) {}
      try {
        var init = { key: key, code: key, keyCode: CODES[dir], which: CODES[dir], bubbles: true, cancelable: true };
        var targets = [w.document, w];
        var b = $(w, '#board'); if (b) targets.push(b);
        var st = $(w, '.stage'); if (st) targets.push(st);
        var cv = $(w, 'canvas'); if (cv) targets.push(cv);
        for (var ti = 0; ti < targets.length; ti++) {
          try { targets[ti].dispatchEvent(new w.KeyboardEvent('keydown', init)); } catch (e) {}
        }
        // 另一条路：原作也支持在 #board 上滑动（位移 >= 24px）
        if (b) {
          var r = b.getBoundingClientRect();
          var cx = r.left + r.width / 2, cy = r.top + r.height / 2;
          var v = VEC[dir] || VEC.left;
          var dd = Math.min(r.width, r.height) * 0.35;
          var p0 = [cx - v[0] * dd, cy - v[1] * dd], p1 = [cx + v[0] * dd, cy + v[1] * dd];
          var fire = function (type, x, y) {
            try {
              b.dispatchEvent(new w.PointerEvent(type, { pointerId: 1, pointerType: 'touch', isPrimary: true, clientX: x, clientY: y, bubbles: true, cancelable: true, buttons: type === 'pointerdown' ? 1 : 0 }));
            } catch (e) {}
            try {
              var t2 = new w.TouchEvent('touch' + (type === 'pointerdown' ? 'start' : type === 'pointerup' ? 'end' : 'move'), {
                bubbles: true, cancelable: true,
                touches: type === 'pointerup' ? [] : [{ clientX: x, clientY: y, identifier: 1 }],
                targetTouches: [], changedTouches: [{ clientX: x, clientY: y, identifier: 1 }]
              });
              b.dispatchEvent(t2);
            } catch (e) {}
          };
          fire('pointerdown', p0[0], p0[1]);
          fire('pointermove', p1[0], p1[1]);
          fire('pointerup', p1[0], p1[1]);
        }
      } catch (e) { S.err = String(e && e.message); }
      try { w.__pnAllow = false; } catch (e) {}
    }
    if (g.log.length > S.applied) S.applied = g.log.length;
  }

  function syncTurn() {
    var ui = S.ui, g = ui && ui.state && ui.state.g;
    if (!g) return;
    var me = ui.pid();
    var mine = g.phase === 'play' && g.players[g.turnIdx] === me;
    var opp = (g.players || []).filter(function (id) { return id !== me; })[0];
    var turn = document.getElementById('t48-turn');
    if (turn) {
      turn.className = 'sk-turn' + (mine ? ' mine' : '');
      turn.innerHTML = mine
        ? '<b>🙋 轮到你走一步</b><span>同一盘，两个人轮流；分数是一起攒的</span>'
        : '<b>👀 等 ' + esc(ui.p(opp) ? ui.p(opp).name : '对方') + ' 走</b><span>他走完就到你</span>';
    }
    var hud = document.getElementById('t48-hud');
    if (hud) {
      hud.innerHTML = '<span class="sk-stat"><i>🎯</i>SCORE ' + (S.score || 0) + '</span>' +
        '<span class="sk-stat"><i>👣</i>MOVES ' + (S.moves || 0) + '</span>' +
        '<span class="sk-stat"><i>🔁</i>第 ' + (g.round || 1) + '/' + (g.rounds || 2) + ' 局</span>' +
        '<span class="sk-stat"><i>💯</i>最高 ' + (g.best || 0) + '</span>';
    }
    var bs = document.querySelectorAll('[data-dir]');
    for (var i = 0; i < bs.length; i++) bs[i].disabled = !mine;
  }

  function poll() {
    var w = frameWin();
    if (!w || !w.document || !w.document.body) return;
    if (w !== S.win) { S.win = w; S.applied = 0; S.started = false; S.clickTries = 0; }
    setup(w);
    try {
      var txt = String(w.document.body.innerText || '');
      var ms = /MOVES[ \t]+([0-9]+)/i.exec(txt), ss = /SCORE[ \t]+([0-9]+)/i.exec(txt);
      if (ms) S.moves = parseInt(ms[1], 10) || 0;
      if (ss) S.score = parseInt(ss[1], 10) || 0;
      S.dom = !!$(w, '#board');
    } catch (e) { S.err = String(e && e.message); }
    var g = S.ui && S.ui.state && S.ui.state.g;
    if (g && g.phase === 'play') {
      var sig = S.score + '|' + S.moves + '|' + (g.log || []).length + '|' + (g.turnIdx || 0);
      if (sig !== S.lastSig) { S.lastSig = sig; S.ui.send({ t: 'score', score: S.score }); }
      var again = $(w, '#againBtn');
      var over = false;
      try { over = !!(again && again.offsetParent !== null); } catch (e) {}
      if (over && !S.overSent && S.applied >= (g.log || []).length && S.moves > 0) {
        S.overSent = true;
        S.ui.send({ t: 'over', score: S.score });
        setTimeout(function () { S.overSent = false; }, 2000);
      }
    }
    applyLog();
  }

  PN.screens = PN.screens || {};
  PN.screens.tile2048 = {
    name: 'tile2048',
    debug: function () { return { applied: S.applied, score: S.score, moves: S.moves, started: S.started, dom: S.dom, err: S.err }; },
    patch: function (state) {
      if (!S.frame || !state.g || state.phase === 'over' || state.mode !== 'tile2048') return false;
      syncTurn(); applyLog();
      return true;
    },
    render: function (state, secret) {
      var ui = this;
      var GC = PN.gameCommon;
      var g = state.g || {};
      var me = ui.pid();
      var myTurn = g.phase === 'play' && g.players && g.players[g.turnIdx] === me;
      var wrap = ui.el('div');
      ui.renderTopbar(wrap);
      wrap.appendChild(ui.h(GC.gameHeader(ui, state, '🔢 2048 肉鸽版（合作）',
        g.phase === 'over' ? '本局结束' : (myTurn ? '轮到你' : '等对方'),
        '<span class="pill">原作整包复用</span>')));

      var body = ui.el('div');
      if (g.phase === 'over') {
        body.appendChild(ui.h('<div class="card center sk-hero"><div class="sk-result">打完 ' + (g.played || 0) + ' 局！🎉</div>' +
          '<div class="muted mt8">最高一局 ' + (g.best || 0) + ' 分 · 双方各 +' + ((g.played || 0) * 2) + ' 分</div></div>'));
        body.appendChild(ui.h(GC.scoreboard(state, undefined, '🏆 总积分')));
        var btns = ui.h(GC.overButtons(ui, 'tile2048'));
        body.appendChild(btns);
        PN.wireOver(btns, ui);
      } else {
        body.appendChild(ui.h('<div class="sk-turn" id="t48-turn"></div>'));
        body.appendChild(ui.h('<div class="sk-hud" id="t48-hud"></div>'));
        var stage = ui.el('div', 'sk-stage t48-stage');
        var frame = S.frame || (S.frame = ui.el('iframe', 'sk-frame t48-frame'));
        frame.setAttribute('allow', 'autoplay');
        frame.setAttribute('referrerpolicy', 'no-referrer');
        stage.appendChild(frame);
        body.appendChild(stage);
        body.appendChild(ui.h('<div class="muted center mt8">方向键 / WASD / 下面十字键 —— 走一步就交给对方</div>'));
        var pad = ui.el('div', 'sk-pad');
        var mk = function (dir, label, cls2) {
          var b = ui.el('button', 'btn ' + (cls2 || 'ghost') + ' sk-key', label);
          b.setAttribute('data-dir', dir);
          b.disabled = !myTurn;
          b.addEventListener('click', function () { ui.send({ t: 'move', dir: dir }); });
          return b;
        };
        pad.appendChild(mk('up', '⬆️', 'primary'));
        var row3 = ui.el('div', 'sk-pad-row');
        row3.appendChild(mk('left', '⬅️'));
        var rs = ui.el('button', 'btn ghost sk-key', '🔄');
        rs.setAttribute('data-reset', '1');
        rs.addEventListener('click', function () { ui.send({ t: 'reset' }); });
        row3.appendChild(rs);
        row3.appendChild(mk('right', '➡️'));
        pad.appendChild(row3);
        pad.appendChild(mk('down', '⬇️', 'primary'));
        body.appendChild(pad);

        S.ui = ui; S.applied = 0; S.started = false; S.clickTries = 0; S.overSent = false; S.lastSig = '';
        var mount = function (base) {
          if (!base) { ui.toast('原作文件没找到（要从仓库根目录打开，见 README）', 'info'); return; }
          if (!frame.getAttribute('src')) frame.src = base + '2048-roguelike-ed8cf859/index.html';
        };
        var base0 = ui.local('pn_t48base') || '';
        if (base0) mount(base0);
        else if (ui.miniBase) ui.miniBase(mount);
        else mount('../mini/');
        if (!S.poller) S.poller = setInterval(poll, 300);
        syncTurn();
      }
      wrap.appendChild(body);
      if (state.phase !== 'over') wrap.appendChild(ui.renderGameFooter());
      return wrap;
    }
  };
})(typeof globalThis !== 'undefined' ? globalThis : this);
