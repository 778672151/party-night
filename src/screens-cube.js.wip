/* ===== 魔方接力 屏幕（复用原作 + 双人兼容）=====
 * 原作在 iframe 里原封跑。父页面用 contentWindow.eval 完成全部双人兼容：
 *   ① 落地：__cubeAPI.applySeq("U R' F2") —— 它自己会排队+播放动画（旋转规则/动画/渲染全用它）
 *   ② 读状态：stateKey()（字符串）、solved()、busyNow()
 *   ③ 捕获阶段拦掉拖拽（canvas 在 shadow DOM 里，所以在 document 上拦，事件仍会经过）
 *   ④ 复原时上报 {t:'solved'}；顺手把 stateKey 报给房主，用于发现两端分叉
 * 不注入桥接脚本，iframe 重载也不会打断同步。 */
(function (root) {
  'use strict';
  var PN = root.PN = root.PN || {};
  var esc = PN.esc;
  var FACES = ['U', 'D', 'L', 'R', 'F', 'B'];

  var S = { frame: null, applied: 0, ui: null, poller: null, win: null, wired: false,
    solved: false, busy: false, key: '', moves: 0, overSent: false, err: null, forked: false };

  function frameWin() { try { return S.frame && S.frame.contentWindow; } catch (e) { return null; } }
  function ev(w, code) { try { return w.eval(code); } catch (e) { S.err = String(e && e.message); return null; } }

  /** 固定种子覆盖 iframe 内的 Math.random：打乱是随机的，两端同种子才可能一致 */
  function installSeed(w) {
    var ui = S.ui, g = ui && ui.state && ui.state.g;
    if (!w || !g || w.__pnSeeded === g.seed) return;
    try {
      var s = g.seed >>> 0;
      w.Math.random = function () {
        s = (s + 0x6D2B79F5) >>> 0;
        var t = s;
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
      w.__pnSeeded = g.seed;
    } catch (e) { S.err = String(e && e.message); }
  }

  function setup(w) {
    if (!w || !w.document || !w.document.body || S.wired === w) return;
    S.wired = w; S.applied = 0; S.moves = 0; S.overSent = false;
    try {
      var block = function (e) { if (w.__pnAllow) return; e.preventDefault(); e.stopPropagation(); };
      w.document.addEventListener('pointerdown', block, true);
      w.document.addEventListener('pointermove', block, true);
      w.document.addEventListener('pointerup', block, true);
      w.document.addEventListener('touchstart', block, true);
      w.document.addEventListener('touchmove', block, true);
      w.document.addEventListener('touchend', block, true);
      w.document.addEventListener('keydown', block, true);
      installSeed(w);   // 必须在打乱之前装好种子
      S.wiredOk = true;
      try { w.__pnAllow = true; ev(w, '__cubeAPI.reset()'); ev(w, '__cubeAPI.scramble()'); w.__pnAllow = false; } catch (e) { w.__pnAllow = false; }   // 初始就是复原状态，先打乱
    } catch (e) { S.err = String(e && e.message); }
  }

  function applyLog() {
    var ui = S.ui, g = ui && ui.state && ui.state.g;
    if (!ui || !g) return;
    var w = frameWin();
    if (!w || !S.wiredOk) return;
    if (g.log.length < S.applied) {                 // 新一局：重打乱，再从头放
      S.applied = 0; S.overSent = false;
      ev(w, '__cubeAPI.reset()');
      ev(w, '__cubeAPI.scramble()');
    }
    for (var i = S.applied; i < g.log.length; i++) {
      var m = String(g.log[i]).replace(/'/g, "'");
      try { w.__pnAllow = true; } catch (e) {}
      ev(w, '__cubeAPI.applySeq(' + JSON.stringify(m) + ')');
      try { w.__pnAllow = false; } catch (e) {}
    }
    if (g.log.length > S.applied) S.applied = g.log.length;
  }

  function syncTurn() {
    var ui = S.ui, g = ui && ui.state && ui.state.g;
    if (!g) return;
    var me = ui.pid();
    var mine = g.phase === 'play' && g.players[g.turnIdx] === me;
    var opp = (g.players || []).filter(function (id) { return id !== me; })[0];
    var turn = document.getElementById('cb-turn');
    if (turn) {
      turn.className = 'sk-turn' + (mine ? ' mine' : '');
      turn.innerHTML = mine
        ? '<b>🙋 轮到你转一步</b><span>下面点一个转动方向；这一手会先交给房主确认，再同时落到两边</span>'
        : '<b>👀 等 ' + esc(ui.p(opp) ? ui.p(opp).name : '对方') + ' 转</b><span>他转完就到你</span>';
    }
    var hud = document.getElementById('cb-hud');
    if (hud) {
      hud.innerHTML = '<span class="sk-stat"><i>🧊</i>第 ' + (g.played || 0) + '/' + (g.rounds || 1) + ' 个</span>' +
        '<span class="sk-stat"><i>👣</i>本局 ' + (g.moves || 0) + ' 步</span>' +
        '<span class="sk-stat"><i>💯</i>共 ' + (g.totalMoves || 0) + ' 步</span>' +
        '<span class="sk-stat"><i>' + (S.solved ? '✅ 已复原' : (S.busy ? '⏳ 转动中' : '🌀 未复原')) + '</i></span>';
    }
    var bs = document.querySelectorAll('[data-face]');
    for (var i = 0; i < bs.length; i++) bs[i].disabled = !mine;
  }

  function poll() {
    var w = frameWin();
    if (!w || !w.document || !w.document.body) return;
    if (w !== S.win) { S.win = w; S.wired = null; S.applied = 0; S.moves = 0; }
    setup(w);
    var st = ev(w, 'JSON.stringify((function(){ try { return { k: __cubeAPI.stateKey(), s: __cubeAPI.solved(), b: __cubeAPI.busyNow(), ok: true }; } catch (e) { return { ok: false, err: String(e && e.message) }; } })())');
    if (st) {
      try {
        var o = JSON.parse(st);
        if (o.ok) {
          S.key = o.k; S.solved = !!o.s; S.busy = !!o.b;
          var g = S.ui && S.ui.state && S.ui.state.g;
          if (g && g.phase === 'play') {
            if (S.solved && S.applied >= (g.log || []).length && !S.overSent) {
              S.overSent = true;
              S.ui.send({ t: 'solved' });
              setTimeout(function () { S.overSent = false; }, 2500);
            }
          }
        }
      } catch (e) { S.err = String(e && e.message); }
    }
    applyLog();
  }

  PN.screens = PN.screens || {};
  PN.screens.cube = {
    name: 'cube',
    debug: function () { return { applied: S.applied, solved: S.solved, busy: S.busy, key: String(S.key).slice(0, 30), err: S.err }; },
    patch: function (state) {
      if (!S.frame || !state.g || state.phase === 'over' || state.mode !== 'cube') return false;
      syncTurn(); applyLog();
      return true;
    },
    render: function (state, secret) {
      var ui = this;
      var GC = PN.gameCommon;
      var g = state.g || {};
      var me = ui.pid();
      var mine = g.phase === 'play' && g.players && g.players[g.turnIdx] === me;
      var wrap = ui.el('div');
      ui.renderTopbar(wrap);
      wrap.appendChild(ui.h(GC.gameHeader(ui, state, '🧊 魔方接力（合作）',
        g.phase === 'over' ? '结束' : (mine ? '轮到你' : '等对方'),
        '<span class="pill">原作整包复用</span>')));

      var body = ui.el('div');
      if (g.phase === 'over') {
        body.appendChild(ui.h('<div class="card center sk-hero"><div class="sk-result">一起复原了 ' + (g.played || 0) + ' 个魔方！🎉</div>' +
          '<div class="muted mt8">总共转了 ' + (g.totalMoves || 0) + ' 步 · 双方各 +' + ((g.played || 0) * 2) + ' 分</div></div>'));
        body.appendChild(ui.h(GC.scoreboard(state, undefined, '🏆 总积分')));
        var btns = ui.h(GC.overButtons(ui, 'cube'));
        body.appendChild(btns);
        PN.wireOver(btns, ui);
      } else {
        body.appendChild(ui.h('<div class="sk-turn" id="cb-turn"></div>'));
        body.appendChild(ui.h('<div class="sk-hud" id="cb-hud"></div>'));
        var stage = ui.el('div', 'sk-stage cb-stage');
        var frame = S.frame || (S.frame = ui.el('iframe', 'sk-frame cb-frame'));
        frame.setAttribute('allow', 'autoplay');
        frame.setAttribute('referrerpolicy', 'no-referrer');
        stage.appendChild(frame);
        body.appendChild(stage);
        body.appendChild(ui.h('<div class="muted center mt8">一人一步接力；点下面按钮转动（不能直接拖画面，两边会不一致）</div>'));
        var pad = ui.el('div', 'cube-pad');
        FACES.forEach(function (f) {
          var b1 = ui.el('button', 'btn ghost sm', f);
          b1.setAttribute('data-face', f);
          b1.disabled = !mine;
          b1.addEventListener('click', function () { ui.send({ t: 'move', m: f }); });
          var b2 = ui.el('button', 'btn ghost sm', f + "'");
          b2.setAttribute('data-face', f + "'");
          b2.disabled = !mine;
          b2.addEventListener('click', function () { ui.send({ t: 'move', m: f + "'" }); });
          pad.appendChild(b1); pad.appendChild(b2);
        });
        body.appendChild(pad);
        var rs = ui.el('button', 'btn ghost sm', '🔄 重新打乱');
        rs.setAttribute('data-reset', '1');
        rs.addEventListener('click', function () { ui.send({ t: 'reset' }); });
        body.appendChild(rs);

        S.ui = ui; S.applied = 0; S.overSent = false;
        var mount = function (base) {
          if (!base) { ui.toast('原作文件没找到（要从仓库根目录打开，见 README）', 'info'); return; }
          if (!frame.getAttribute('src')) frame.src = base + 'rubik-anime-lab-0b0c6984/index.html';
        };
        var base0 = ui.local('pn_cbbase') || '';
        if (base0) mount(base0);
        else if (ui.miniBase) ui.miniBase(mount);
        else mount('../mini/');
        if (!S.poller) S.poller = setInterval(poll, 300);
        syncTurn();
      }
      wrap.appendChild(body);
      if (state.phase !== 'over') wrap.appendChild(ui.renderGameFooter());
      return wrap;
    }
  };
})(typeof globalThis !== 'undefined' ? globalThis : this);
